{
  "name": "ifindata-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:checks && npm run build",
    "test:analytics": "tsx --test tests/analytics/*.test.ts",
    "test:auth": "tsx --test tests/auth/*.test.ts",
    "test:watchlists": "tsx --test tests/watchlists/*.test.ts",
    "firestore:indexes:apply": "tsx scripts/firestore/apply-indexes.ts",
    "smoke:test": "playwright test",
    "test:conversion": "playwright test --config=playwright.conversion.config.ts",
    "test:graph": "tsx --test tests/graph/repository.test.ts tests/knowledge-graph.test.ts",
    "test:securities": "tsx --test tests/securities/*.test.ts",
    "test:industry": "tsx --test tests/industry/model.test.ts tests/industry/quality.test.ts tests/industry/saved-companies.test.ts tests/industry/discovery.test.ts tests/industry/company-research.test.tsx tests/industry/directory.test.ts tests/industry/research.test.ts",
    "smoke:install": "playwright install chromium",
    "deploy:staging": "./scripts/deploy-cloud-run.sh staging",
    "deploy:production": "./scripts/deploy-cloud-run.sh production",
    "verify:checks": "npm run lint && npm run typecheck && npm run test:analytics && npm run test:securities && npm run test:watchlists"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "cytoscape": "^3.33.3",
    "d3-force-3d": "^3.0.6",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
