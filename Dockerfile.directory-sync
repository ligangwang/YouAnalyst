FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY data/ai-supply-chain/company-names.json ./data/ai-supply-chain/company-names.json
RUN node_modules/.bin/esbuild scripts/sync-cni-directory.ts --bundle --platform=node --packages=external --outfile=dist/sync-cni-directory.cjs \
  && node_modules/.bin/esbuild scripts/serve-cni-directory.ts --bundle --platform=node --packages=external --outfile=dist/serve-cni-directory.cjs && npm prune --omit=dev

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/python && /opt/python/bin/pip install --no-cache-dir openpyxl==3.1.5
ENV PATH="/opt/python/bin:$PATH"
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY scripts/download-cni-directory.py ./scripts/download-cni-directory.py
USER node
CMD ["node", "dist/sync-cni-directory.cjs"]
