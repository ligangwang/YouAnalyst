FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && npm ci && rm -rf /var/lib/apt/lists/*
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY tests ./tests
RUN node_modules/.bin/tsx --test tests/graph/price-sync.test.ts tests/graph/entity-snapshots.test.ts tests/graph/sqlite-storage.test.ts \
 && node_modules/.bin/esbuild scripts/sync-price-snapshots.ts --bundle --platform=node --packages=external --outfile=dist/sync-price-snapshots.cjs --metafile=dist/sync-price-snapshots.meta.json \
 && npm prune --omit=dev --ignore-scripts --no-audit --no-fund && node scripts/prune-worker-dependencies.mjs
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
USER node
CMD ["node", "dist/sync-price-snapshots.cjs"]
