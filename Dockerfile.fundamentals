FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && npm ci \
  && rm -rf /var/lib/apt/lists/*
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY data/ai-supply-chain/company-names.json ./data/ai-supply-chain/company-names.json
COPY data/company-link-slugs.json ./data/company-link-slugs.json
# Shared maintenance image; each deployed job selects its worker command.
RUN node_modules/.bin/esbuild scripts/refresh-sec-fundamentals.ts --bundle --platform=node --packages=external --outfile=dist/refresh-sec-fundamentals.cjs --metafile=dist/refresh-sec-fundamentals.meta.json \
  && node_modules/.bin/esbuild scripts/serve-sec-fundamentals.ts --bundle --platform=node --packages=external --outfile=dist/serve-sec-fundamentals.cjs --metafile=dist/serve-sec-fundamentals.meta.json \
  && node_modules/.bin/esbuild scripts/serve-sec-downloads.ts --bundle --platform=node --packages=external --outfile=dist/serve-sec-downloads.cjs --metafile=dist/serve-sec-downloads.meta.json \
  && node_modules/.bin/esbuild scripts/serve-sec-discovery.ts --bundle --platform=node --packages=external --outfile=dist/serve-sec-discovery.cjs --metafile=dist/serve-sec-discovery.meta.json \
  && node_modules/.bin/esbuild scripts/serve-news-enrichment.ts --bundle --platform=node --packages=external --outfile=dist/serve-news-enrichment.cjs --metafile=dist/serve-news-enrichment.meta.json \
  && node_modules/.bin/esbuild scripts/cleanup-sec-downloads.ts --bundle --platform=node --packages=external --outfile=dist/cleanup-sec-downloads.cjs --metafile=dist/cleanup-sec-downloads.meta.json \
  && node_modules/.bin/esbuild scripts/refresh-cn-fundamentals.ts --bundle --platform=node --packages=external --outfile=dist/refresh-cn-fundamentals.cjs --metafile=dist/refresh-cn-fundamentals.meta.json \
  && node_modules/.bin/esbuild scripts/serve-cn-fundamentals.ts --bundle --platform=node --packages=external --outfile=dist/serve-cn-fundamentals.cjs --metafile=dist/serve-cn-fundamentals.meta.json \
  && node_modules/.bin/esbuild scripts/serve-eod-maintenance.ts --bundle --platform=node --packages=external --outfile=dist/serve-eod-maintenance.cjs --metafile=dist/serve-eod-maintenance.meta.json \
  && node_modules/.bin/esbuild scripts/collect-sec-filings.ts --bundle --platform=node --packages=external --outfile=dist/collect-sec-filings.cjs --metafile=dist/collect-sec-filings.meta.json \
  && node_modules/.bin/esbuild scripts/refresh-company-graph.ts --bundle --platform=node --packages=external --outfile=dist/refresh-company-graph.cjs --metafile=dist/refresh-company-graph.meta.json \
  && node_modules/.bin/esbuild scripts/serve-company-graph.ts --bundle --platform=node --packages=external --outfile=dist/serve-company-graph.cjs --metafile=dist/serve-company-graph.meta.json \
  && node_modules/.bin/esbuild scripts/collect-earnings.ts --bundle --platform=node --packages=external --outfile=dist/collect-earnings.cjs --metafile=dist/collect-earnings.meta.json \
  && node_modules/.bin/esbuild scripts/serve-earnings.ts --bundle --platform=node --packages=external --outfile=dist/serve-earnings.cjs --metafile=dist/serve-earnings.meta.json \
  && node_modules/.bin/esbuild scripts/collect-intelligence-news.ts --bundle --platform=node --packages=external --outfile=dist/collect-intelligence-news.cjs --metafile=dist/collect-intelligence-news.meta.json \
  && node_modules/.bin/esbuild scripts/serve-cn-discovery.ts --bundle --platform=node --packages=external --outfile=dist/serve-cn-discovery.cjs --metafile=dist/serve-cn-discovery.meta.json \
  && node_modules/.bin/esbuild scripts/serve-intelligence-news.ts --bundle --platform=node --packages=external --outfile=dist/serve-intelligence-news.cjs --metafile=dist/serve-intelligence-news.meta.json \
  && node_modules/.bin/esbuild scripts/backfill-event-classifications.ts --bundle --platform=node --packages=external --outfile=dist/backfill-event-classifications.cjs --metafile=dist/backfill-event-classifications.meta.json \
  && node_modules/.bin/esbuild scripts/sync-entity-snapshots.ts --bundle --platform=node --packages=external --outfile=dist/sync-entity-snapshots.cjs --metafile=dist/sync-entity-snapshots.meta.json \
  && node_modules/.bin/esbuild scripts/onboard-instruments.ts --bundle --platform=node --packages=external --outfile=dist/onboard-instruments.cjs --metafile=dist/onboard-instruments.meta.json \
  && node_modules/.bin/esbuild scripts/serve-instrument-onboarding.ts --bundle --platform=node --packages=external --outfile=dist/serve-instrument-onboarding.cjs --metafile=dist/serve-instrument-onboarding.meta.json \
  && npm prune --omit=dev --ignore-scripts --no-audit --no-fund && node scripts/prune-worker-dependencies.mjs

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv poppler-utils && rm -rf /var/lib/apt/lists/*
COPY scripts/akshare-requirements.txt ./scripts/akshare-requirements.txt
RUN python3 -m venv /opt/akshare && /opt/akshare/bin/pip install --no-cache-dir -r scripts/akshare-requirements.txt
ENV AKSHARE_PYTHON=/opt/akshare/bin/python
COPY scripts/fetch-cn-annual.py ./scripts/fetch-cn-annual.py
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
USER node
CMD ["node", "dist/refresh-sec-fundamentals.cjs"]
