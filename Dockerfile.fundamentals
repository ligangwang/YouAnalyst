FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
# Shared maintenance image; each deployed job selects its worker command.
RUN node_modules/.bin/esbuild scripts/refresh-sec-fundamentals.ts --bundle --platform=node --packages=external --outfile=dist/refresh-sec-fundamentals.cjs \
  && node_modules/.bin/esbuild scripts/serve-sec-fundamentals.ts --bundle --platform=node --packages=external --outfile=dist/serve-sec-fundamentals.cjs \
  && node_modules/.bin/esbuild scripts/refresh-cn-fundamentals.ts --bundle --platform=node --packages=external --outfile=dist/refresh-cn-fundamentals.cjs \
  && node_modules/.bin/esbuild scripts/refresh-private-valuations.ts --bundle --platform=node --packages=external --outfile=dist/refresh-private-valuations.cjs \
  && node_modules/.bin/esbuild scripts/serve-private-valuations.ts --bundle --platform=node --packages=external --outfile=dist/serve-private-valuations.cjs \
  && node_modules/.bin/esbuild scripts/serve-ticker-sync.ts --bundle --platform=node --packages=external --outfile=dist/serve-ticker-sync.cjs \
  && node_modules/.bin/esbuild scripts/serve-cn-fundamentals.ts --bundle --platform=node --packages=external --outfile=dist/serve-cn-fundamentals.cjs \
  && npm prune --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
COPY scripts/akshare-requirements.txt ./scripts/akshare-requirements.txt
RUN python3 -m venv /opt/akshare && /opt/akshare/bin/pip install --no-cache-dir -r scripts/akshare-requirements.txt
ENV AKSHARE_PYTHON=/opt/akshare/bin/python
COPY scripts/fetch-cn-annual.py ./scripts/fetch-cn-annual.py
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
USER node
CMD ["node", "dist/refresh-sec-fundamentals.cjs"]
