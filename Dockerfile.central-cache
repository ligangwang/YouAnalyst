FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY data/company-link-slugs.json ./data/company-link-slugs.json
COPY data/ai-supply-chain/company-names.json ./data/ai-supply-chain/company-names.json
COPY data/company-url-slugs.json ./data/company-url-slugs.json
RUN node_modules/.bin/esbuild scripts/serve-central-cache.ts --bundle --platform=node --packages=external --outfile=dist/server.cjs && npm prune --omit=dev
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=640
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
CMD ["node","dist/server.cjs"]
